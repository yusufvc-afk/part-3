<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-dark racedayn-nav">
 <div class="container">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RACEDAY</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="mainNav">
   <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>
    @if (Context.Session.GetString("Role") == "Participant") {
      <li class="nav-item"><a class="nav-link" href="/Participant/MyEvents">My events</a></li>
      <li class="nav-item"><a class="nav-link" href="/Participant/MyResults">My results</a></li>
      <li class="nav-item"><a class="nav-link" href="/Participant/Profile">Profile</a></li>
    }
    @if (Context.Session.GetString("Role") == "Organiser") {
      <li class="nav-item"><a class="nav-link" href="/Organiser/Dashboard">Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" href="/Organiser/Events">Manage events</a></li>
    }
   </ul>
   @if (Context.Session.GetString("ApiAuthCookie") == null) {
      <a class="btn btn-outline-light me-2" asp-controller="Account" asp-action="Login">Login</a>
      <a class="btn btn-warning" asp-controller="Account" asp-action="Register">Register</a>
   } else {
      <span class="text-white me-3">@Context.Session.GetString("FirstName")</span>
      <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-light">Logout</button></form>
   }
  </div>
 </div>
</nav>
</header>
<main class="container py-4">
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
@RenderBody()
</main>
<footer class="container py-4 text-muted border-top">RaceDay | Run. Walk. Cycle. Together.</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
