@model List<System.Text.Json.JsonElement>
@{ ViewData["Title"] = "Upcoming events"; }
<section class="hero p-5 rounded mb-4">
    <h1>Make every kilometre count.</h1>
    <p>Find your next RaceDay event and get moving.</p>
</section>
<h2>RaceDay events</h2>
@if (Model.Count == 0) { <p>No events are currently available.</p> }
<div class="row g-3">
@foreach (var item in Model)
{
    var id = item.GetProperty("eventId").GetInt32();
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h3 class="h5">@item.GetProperty("eventName").GetString()</h3>
                <p>@item.GetProperty("location").GetString()</p>
                <p>@item.GetProperty("eventDate").ToString()</p>
                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@id">View event</a>
            </div>
        </div>
    </div>
}
</div>
